      "id": 1,
      "title": "Active Reviews",
      "type": "stat",
      "targets": [
        {
          "expr": "openreview_active_reviews",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Total API Requests / sec",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(openreview_http_requests_total[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Total LLM Spend (USD)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(openreview_llm_cost_usd_total)",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Worker Failures",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(openreview_worker_tasks_total{status=\"failure\"})",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "title": "API Request Throughput by Status Code",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (status) (rate(openreview_http_requests_total[1m]))",
          "legendFormat": "HTTP {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "title": "API Latency (Seconds)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "openreview_http_request_duration_seconds",
          "legendFormat": "{{method}} {{path}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 7,
      "title": "Token Consumption by Model",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (model, type) (rate(openreview_llm_tokens_total[5m]))",
          "legendFormat": "{{model}} ({{type}})",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 8,
      "title": "Worker Task Execution Rate by Queue",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (task, status) (rate(openreview_worker_tasks_total[1m]))",
          "legendFormat": "{{task}} - {{status}}",
          "refId": "A"
        }
      ]
    }
  ],
