# ==============================================================================
# OpenReview AI - Production Multi-Stage Celery Worker Dockerfile
# ==============================================================================

# Stage 1: Build & wheels compilation
FROM python:3.12-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libpq-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt ./
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir --prefix=/install -r requirements.txt

# Stage 2: Minimal hardened worker runtime
FROM python:3.12-slim AS runtime

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Create non-root system user and group
RUN groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -s /bin/bash -m appuser

# Copy application and workers source code
COPY backend /app/backend
COPY workers /app/workers

WORKDIR /app
RUN chown -R appuser:appgroup /app

USER 10001:10001

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/backend:/app \
    APP_ENV=production \
    LOG_FORMAT=json

# Healthcheck for Celery worker (inspect ping)
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD python -m celery -A workers.celery_app status || exit 1

# Default command launches Celery worker listening on all application queues
CMD ["celery", "-A", "workers.celery_app", "worker", "--loglevel=info", "-Q", "reviews,indexing,autofix,publishing,default,dead_letter", "--concurrency=4"]
