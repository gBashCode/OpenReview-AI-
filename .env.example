# ==============================================================================
# OpenReview AI - Environment Configuration Example
# Copy this file to .env and customize values for your environment.
# ==============================================================================

# Application Settings
APP_NAME="OpenReview AI"
APP_ENV=development
DEBUG=true
API_V1_PREFIX="/api/v1"
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# CORS Configuration (comma-separated allowed origins)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Database Configuration (PostgreSQL + pgvector)
# Format for asyncpg: postgresql+asyncpg://user:password@host:port/dbname
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=openreview
POSTGRES_USER=openreview_admin
POSTGRES_PASSWORD=openreview_secure_password
DATABASE_URL=postgresql+asyncpg://openreview_admin:openreview_secure_password@localhost:5432/openreview
# Fallback / Test DB (optional SQLite for quick testing without Docker)
# DATABASE_URL=sqlite+aiosqlite:///./openreview_dev.db

# Redis & Background Workers (Celery)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# GitHub App Integration
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY_PATH=""
GITHUB_WEBHOOK_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth Integration
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5173/auth/callback"

# AI / LLM Configuration
# Options: openai, anthropic, gemini, groq, ollama
DEFAULT_LLM_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""
GROQ_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# Observability & Logging
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# LOG_FORMAT: json or console
LOG_FORMAT=console
