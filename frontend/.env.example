# OpenReview AI Frontend Environment Configuration Template
# Copy to .env.local for local overrides or configure in Vercel project settings

# Backend API Base URL (leave blank to proxy through /api/v1 via Vite/Vercel rewrites)
VITE_API_BASE_URL=/api/v1

# Target Environment
VITE_APP_ENV=development

# GitHub App Integration
VITE_GITHUB_APP_NAME=openreview-ai

# Observability
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.2
